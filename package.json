{
    "name": "biblioteca-escolar-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "db:up": "docker start biblioteca-api || docker run -d --name biblioteca-api -p 127.0.0.1:27017:27017 -v biblioteca-api-data:/data/db mongo:8",
        "db:down": "docker stop biblioteca-api",
        "db:logs": "docker logs -f biblioteca-api",
        "db:reset": "docker rm -f biblioteca-api; docker volume rm biblioteca-api-data",
        "predev": "npm run db:up",
        "dev": "node --watch src/server.js",
        "start": "node src/server.js"
    },
    "dependencies": {
        "dotenv": "^18.0.10",
        "express": "5.2.1",
        "mdb": "^0.1.0",
        "mongodb": "^7.8.0"
    }
}
